{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:parallel-development:task:1",
  "title": "Parallel Development Task Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "plan",
    "role",
    "engine",
    "objective",
    "base_commit",
    "contract_versions",
    "depends_on",
    "write_scope",
    "exclusive_resources",
    "acceptance",
    "expected_artifacts",
    "retry",
    "final_review_required"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "scope_digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "scope_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "role": {
      "enum": [
        "coordinator",
        "worker",
        "verifier",
        "integrator"
      ]
    },
    "engine": {
      "enum": [
        "codex",
        "zcode"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "base_commit": {
      "type": "string",
      "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "contract_versions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "digest"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "gate"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
          },
          "gate": {
            "enum": [
              "contract_ready",
              "implementation_verified",
              "integrated_verified",
              "final_accepted"
            ]
          },
          "artifact_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "write_scope": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Normalized repository-relative exact path or directory prefix. The runtime must reject traversal, symlink escape, aliases, and invalid platform paths."
          },
          "kind": {
            "enum": [
              "file",
              "directory"
            ]
          }
        }
      }
    },
    "exclusive_resources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "criterion"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
          },
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "cwd": {
            "type": "string",
            "description": "Relative path inside the assigned worker workspace."
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1
          },
          "required": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "expected_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "default": 50
    },
    "estimated_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_retries",
        "backoff_ms"
      ],
      "properties": {
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "description": "Automatic retries after the initial attempt; the global design policy permits at most two. A stricter project or task budget may reduce this limit."
        },
        "backoff_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "final_review_required": {
      "const": true
    },
    "notes": {
      "type": "string"
    }
  },
  "description": "Data contract only. Valid JSON does not establish authorization, safe paths, satisfied dependencies, or review approval."
}
